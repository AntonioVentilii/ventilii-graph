{
	"name": "ventilii-graph",
	"version": "1.6.0",
	"private": true,
	"scripts": {
		"dev": "vite dev --force",
		"dev:api": "node --watch --env-file-if-exists=.env server/index.ts",
		"build": "tsc --noEmit && vite build",
		"build:api": "esbuild server/index.ts --bundle --platform=node --format=esm --target=node26 --outfile=build-api/server.mjs && esbuild server/oidc-helper.ts --bundle --platform=node --format=esm --target=node26 --outfile=build-api/oidc-helper.mjs",
		"prepare": "svelte-kit sync",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p server",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write . && eslint . --fix",
		"quality": "npm run format && npm run lint"
	},
	"devDependencies": {
		"@dfinity/eslint-config-oisy-wallet": "^0.5.1",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/postcss": "4.3.4",
		"@tailwindcss/vite": "4.3.4",
		"@types/eslint": "^9.6.1",
		"@types/node": "^26.6.6",
		"esbuild": "^0.28.2",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.0",
		"globals": "^17.14.0",
		"postcss": "^8.5.26",
		"prettier": "^3.9.10",
		"prettier-plugin-organize-imports": "^4.3.0",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwindcss": "4.3.4",
		"tslib": "^2.8.1",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.6"
	},
	"type": "module",
	"dependencies": {
		"@anthropic-ai/sdk": "^1.5.0",
		"@lucide/svelte": "^1.69.0"
	},
	"overrides": {
		"lightningcss": "1.33.0",
		"tailwindcss": "4.3.4",
		"@tailwindcss/postcss": "4.3.4",
		"@tailwindcss/vite": "4.3.4",
		"@dfinity/eslint-config-oisy-wallet": {
			"typescript": "$typescript"
		}
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
